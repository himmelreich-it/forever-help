# Copy to .env (git-ignored) and fill in. Create your own app at
# https://develop.battle.net/access/clients and register this redirect URI:
#   http://localhost:8765/callback
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
# eu, us, kr or tw
BNET_REGION=eu
BNET_LOCALE=en_GB
# Your main character's slug (name-surname, lower case); used when a command omits NAME
BNET_MAIN=
# Optional: override the login redirect (must also be registered on your app)
# BNET_REDIRECT=http://localhost:8765/callback
